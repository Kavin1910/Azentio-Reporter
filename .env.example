# ---- Supabase ----
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_PROJECT_URL=
# Anon/publishable key — safe in the browser, RLS enforced
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Never expose to the browser.
# Used solely by the officer portal for assessment generation and seeding.
SUPABASE_SERVICE_ROLE_KEY=

# ---- OpenRouter ----
OPENROUTER_KEY=
# Model slug. Verify against https://openrouter.ai/models before changing.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Optional attribution headers OpenRouter uses for ranking
OPENROUTER_SITE_URL=http://localhost:3001
OPENROUTER_SITE_NAME=Azentio Loan Assistant

# Server-side key that encrypts saved database-connection passwords. Any 16+ char string.
SOURCE_ENCRYPTION_KEY=

# Only for local development. Permits database connections to localhost / private ranges.
# ALLOW_PRIVATE_DB_HOSTS=true
